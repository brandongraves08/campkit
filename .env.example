# CampKit environment. Copy to .env, replace every placeholder, then
#   chmod 600 .env
# The file is git-ignored and is the only place secrets live: the image and
# compose.yaml contain no credentials. Never commit the filled-in copy.
#
# Generate the secrets with, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
DEBUG=false
# Hostnames the reverse proxy serves. Loopback alone is not enough for a
# home-network name such as campkit.lan.
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL. compose.yaml overrides POSTGRES_HOST/POSTGRES_PORT for the app so
# it reaches the database over the compose network; keep these values for a
# non-container local run.
POSTGRES_DB=campkit
POSTGRES_USER=campkit
POSTGRES_PASSWORD=replace-with-a-strong-local-database-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Host port the container publishes on, always bound to 127.0.0.1.
CAMPKIT_HTTP_PORT=8000

# Origins the reverse proxy serves, as scheme://host[:port]. Required for form
# POSTs (CSRF) when the app is reached under a name other than localhost.
# CAMPKIT_CSRF_TRUSTED_ORIGINS=https://campkit.lan

# Durable application data inside the container (the campkit_data volume).
# Only change this if you also change the volume mount in compose.yaml.
# CAMPKIT_DATA_DIR=/data

# Backup destination and retention used by deploy/backup.sh. Keep backups
# outside this repository.
# CAMPKIT_BACKUP_DIR=/srv/campkit-backups
# CAMPKIT_BACKUP_RETENTION_DAYS=14

# Optional provider credentials. Unset means the shipped null provider: no
# data, no fabrication, and manual entry still works.
# CAMPKIT_USDA_API_KEY=
# CAMPKIT_VISION_CLIENT=
# CAMPKIT_VISION_ENDPOINT=
# CAMPKIT_VISION_TOKEN=
